# Ultra-simple Railway startup for Frappe LMS
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    libpq-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m frappe

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
RUN pip install --no-cache-dir \
    psycopg2-binary \
    gunicorn \
    flask \
    jinja2 \
    werkzeug

# Copy LMS app and Flask app
COPY --chown=frappe:frappe ./lms ./lms
COPY --chown=frappe:frappe ./railway-flask-app.py ./app.py

# Switch to app user
USER frappe

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start the application
CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 1 app:app